# BugBounty Swarm — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ─── Google AI ────────────────────────────────────────────────────────────────
# AI Studio key for Gemini API (development)
GEMINI_API_KEY=your_ai_studio_key_here

# Optionally switch to Vertex AI in production (no code changes required)
# GOOGLE_CLOUD_PROJECT=your_gcp_project_id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json

# ─── Google Cloud ─────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your_gcp_project_id
GCP_REGION=us-central1

# Firestore database (use "(default)" for the default database)
FIRESTORE_DATABASE=(default)

# Cloud Tasks queue for durable investigation execution
CLOUD_TASKS_QUEUE=investigations
CLOUD_TASKS_LOCATION=us-central1

# Internal Cloud Run service URL (used by Cloud Tasks to dispatch runner)
# In production: https://your-backend-service-url.run.app
# In development: http://localhost:8000
RUNNER_BASE_URL=http://localhost:8000

# Cloud Storage bucket for large evidence and report payloads
GCS_BUCKET_NAME=bugbounty-swarm-evidence

# API authentication secret (static API key for hackathon)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=dev_secret_key_12345678901234567890123456789012


# Set to "true" to enable Firebase Auth (overrides static API key)
USE_FIREBASE_AUTH=false

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Environment: development | staging | production
ENVIRONMENT=development

# ─── Investigation Limits ─────────────────────────────────────────────────────
MAX_INVESTIGATIONS_PER_HOUR=5
MAX_LOOP_ITERATIONS=4
MAX_RETRIES=2
AGENT_TIMEOUT_SECONDS=300

# ─── Local Development Only ───────────────────────────────────────────────────
# Set to "true" to use Firestore emulator instead of real Firestore
USE_FIRESTORE_EMULATOR=true
FIRESTORE_EMULATOR_HOST=localhost:8080
